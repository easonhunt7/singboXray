#!/bin/bash

export LANG=en_US.UTF-8
green() { echo -e "\e[1;32m$1\033[0m"; }
yellow() { echo -e "\e[1;33m$1\033[0m"; }
red() { echo -e "\e[1;91m$1\033[0m"; }

# ================== 容器环境路径与端口适配 ==================
cd "$(dirname "$0")"
work_dir="${PWD}/.npm"
mkdir -p "${work_dir}"

# 自动挂载 Pterodactyl 面板分配的唯一端口给 H3/xHTTP 或 Reality
PANEL_PORT=${PORT:-"30223"}
# ==========================================================

# Github Cloudflare安全代理
GITHUB_PROXY=('https://ess.ieshare.workers.dev/')
download_file() {
    local output_path="$1"
    local official_url="$2"
    
    # 1. 尝试直连官方地址
    echo "连接Github官方源中..."
    if curl -sL --connect-timeout 5 --max-time 60 -o "$output_path" "$official_url"; then
        if [ -s "$output_path" ]; then
            green "下载成功！"
            return 0
        fi
    fi
    
    # 2. 直连失败，轮询切换代理
    yellow "Github连接失败，转向Cloudflare安全代理..."
    for proxy in "${GITHUB_PROXY[@]}"; do
        local proxy_url="${proxy}${official_url}"
        if curl -sL --connect-timeout 5 --max-time 60 -o "$output_path" "$proxy_url"; then
            if [ -s "$output_path" ]; then
                green "下载成功！"
                return 0
            fi
        fi
    done
    
    red "错误：官方源及镜像代理下载均告失败！"
    return 1
}

# 默认在 Pterodactyl 中启用 H3/xHTTP (或者通过面板传递参数)
ARG_H3="${PANEL_PORT}"
ARG_REALITY=""
ARG_ARGO_PROTOCOL="quic"
ARG_ARGO_PORT="8001"
ARG_ARGO_DOMAIN=""
ARG_ARGO_TOKEN=""

# 智能解析复合与关键字参数
for arg in "$@"; do
    clean_arg="${arg//\"/}"
    clean_arg="${clean_arg//\'/}"
    
    if [[ "$clean_arg" =~ ^[hH]3(.*)$ ]]; then
        ARG_H3="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^[rR][eE][aA][lL][iI][tT][yY](.*)$ ]]; then
        ARG_REALITY="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^argo[pP][rR][oO][tT][oO][cC][oO][lL](.*)$ ]] || [[ "$clean_arg" =~ ^[pP][rR][oO][tT][oO][cC][oO][lL](.*)$ ]]; then
        ARG_ARGO_PROTOCOL="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^argo[pP][oO][rR][tT](.*)$ ]] || [[ "$clean_arg" =~ ^[pP][rR][oO][rR][tT](.*)$ ]]; then
        ARG_ARGO_PORT="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^argo[dD][oO][mM][aA][iI][nN](.*)$ ]] || [[ "$clean_arg" =~ ^[dD][oO][mM][aA][iI][nN](.*)$ ]]; then
        ARG_ARGO_DOMAIN="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^argo[tT][oO][kK][eE][nN](.*)$ ]] || [[ "$clean_arg" =~ ^[tT][oO][kK][eE][nN](.*)$ ]]; then
        ARG_ARGO_TOKEN="${BASH_REMATCH[1]}"
    elif [[ "$clean_arg" =~ ^[0-9]+$ ]] || [[ "$clean_arg" =~ ^[yYnN]$ ]]; then
        if [ -z "$ARG_H3" ]; then
            ARG_H3="$clean_arg"
        elif [ -z "$ARG_REALITY" ]; then
            ARG_REALITY="$clean_arg"
        fi
    fi
done

parse_port() {
    local input="$1"
    [ -z "$input" ] && echo "" && return
    if [ "$input" = "n" ] || [ "$input" = "N" ]; then
        echo ""
    elif [ "$input" = "y" ] || [ "$input" = "Y" ]; then
        echo "${PANEL_PORT}"
    elif [[ "$input" =~ ^[0-9]+$ ]]; then
        echo "$input"
    else
        echo ""
    fi
}

h3_port=$(parse_port "$ARG_H3")
reality_port=$(parse_port "$ARG_REALITY")

argo_port="${ARG_ARGO_PORT:-8001}"
argo_protocol="${ARG_ARGO_PROTOCOL:-quic}"
argo_domain="${ARG_ARGO_DOMAIN}"
argo_token="${ARG_ARGO_TOKEN}"

enable_argo=false
if [ -n "$argo_port" ] && [ -n "$argo_domain" ] && [ -n "$argo_token" ] && [ -n "$argo_protocol" ]; then
    enable_argo=true
fi

if [ -z "$h3_port" ] && [ -z "$reality_port" ] && [ "$enable_argo" = false ]; then
    yellow "提示：未检测到任何有效变量（H3、REALITY及Argo隧道均未启用）。"
    exit 0
fi

# 清理旧残留进程
pkill -9 -f xray 2>/dev/null || true
pkill -9 -f cloudflared 2>/dev/null || true

green "正在初始化环境（容器路径适配模式）..."

# 1. 下载 Xray-core
echo "正在下载 Xray-core..."
ARCH_RAW=$(uname -m)
case "${ARCH_RAW}" in
    'x86_64' | 'amd64') ARCH='64' ;;
    'aarch64' | 'arm64') ARCH='arm64-v8a' ;;
    *) ARCH='64' ;;
esac

download_file "${work_dir}/xray.zip" "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${ARCH}.zip" || exit 1

# 使用内置 python3 或 unzip 解压，适配容器无 root 权限
if command -v unzip >/dev/null 2>&1; then
    unzip -qo "${work_dir}/xray.zip" -d "${work_dir}/"
elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import zipfile; zipfile.ZipFile('${work_dir}/xray.zip', 'r').extractall('${work_dir}/')"
else
    red "错误：缺少解压工具！"
    exit 1
fi

rm -f "${work_dir}/xray.zip"
chmod +x ${work_dir}/xray

# 如果开启了 Argo，下载 cloudflared
if [ "$enable_argo" = true ]; then
    echo "正在下载 Cloudflared..."
    ARCH_CF=$(uname -m)
    case "${ARCH_CF}" in
        'x86_64' | 'amd64') CF_ARCH='amd64' ;;
        'aarch64' | 'arm64') CF_ARCH='arm64' ;;
        *) CF_ARCH='amd64' ;;
    esac
    download_file "${work_dir}/cloudflared" "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}" || exit 1
    chmod +x "${work_dir}/cloudflared"
fi

# 2. 生成变量、自签证书与密钥对
echo "生成安全 UUID、自签证书及密钥对..."
UUID_FILE="${work_dir}/uuid.txt"
if [ -f "$UUID_FILE" ]; then
    uuid=$(cat "$UUID_FILE")
else
    uuid=$(cat /proc/sys/kernel/random/uuid)
    echo "$uuid" > "$UUID_FILE"
    chmod 600 "$UUID_FILE"
fi

h3_path="${uuid}-xu" 
argo_path="${uuid}-argo"
ym_vl_re="www.apple.com"

# H3 自签证书
openssl ecparam -genkey -name prime256v1 -out "${work_dir}/private.key" 2>/dev/null || true
openssl req -new -x509 -days 3650 -key "${work_dir}/private.key" -out "${work_dir}/cert.pem" -subj "/CN=bing.com" 2>/dev/null || true
chmod 600 "${work_dir}/private.key"

# Reality 密钥对
key_pair=$("${work_dir}/xray" x25519)
private_key_x=$(echo "$key_pair" | grep -i "private" | head -n 1 | sed 's/.*:[[:space:]]*//' | tr -d '[:space:]')
public_key_x=$(echo "$key_pair" | grep -i -E "public|password" | head -n 1 | sed 's/.*:[[:space:]]*//' | tr -d '[:space:]')
if [ -z "$private_key_x" ]; then
    private_key_x=$(echo "$key_pair" | awk 'NR==1{print $3}')
    public_key_x=$(echo "$key_pair" | awk 'NR==2{print $3}')
fi
short_id_x=$(date +%s%N | sha256sum | cut -c 1-8)

# 3. 构建多 Inbound 配置
inbounds_arr=()

if [ -n "$reality_port" ]; then
    inbounds_arr+=( "{
      \"tag\": \"tcp-reality\",
      \"listen\": \"::\",
      \"port\": $reality_port,
      \"protocol\": \"vless\",
      \"settings\": {
        \"clients\": [{\"id\": \"$uuid\", \"flow\": \"xtls-rprx-vision\"}],
        \"decryption\": \"none\"
      },
      \"streamSettings\": {
        \"network\": \"tcp\",
        \"security\": \"reality\",
        \"realitySettings\": {
          \"show\": false,
          \"dest\": \"$ym_vl_re:443\",
          \"xver\": 0,
          \"serverNames\": [\"$ym_vl_re\"],
          \"privateKey\": \"$private_key_x\",
          \"shortIds\": [\"$short_id_x\"]
        }
      },
      \"sniffing\": {\"enabled\": true, \"destOverride\": [\"http\", \"tls\", \"quic\"], \"metadataOnly\": false}
    }" )
fi

if [ -n "$h3_port" ]; then
    inbounds_arr+=( "{
      \"tag\": \"xhttp-h3\",
      \"listen\": \"::\",
      \"port\": $h3_port,
      \"protocol\": \"vless\",
      \"settings\": {
        \"clients\": [{\"id\": \"$uuid\", \"flow\": \"\"}],
        \"decryption\": \"none\"
      },
      \"streamSettings\": {
        \"network\": \"xhttp\",
        \"security\": \"tls\",
        \"xhttpSettings\": {
          \"mode\": \"auto\",
          \"path\": \"/$h3_path\"
        },
        \"tlsSettings\": {
          \"alpn\": [\"h3\", \"h2\", \"http/1.1\"],
          \"certificates\": [{\"certificateFile\": \"$work_dir/cert.pem\", \"keyFile\": \"$work_dir/private.key\"}]
        }
      },
      \"sniffing\": {\"enabled\": true, \"destOverride\": [\"http\", \"tls\", \"quic\"], \"metadataOnly\": false}
    }" )
fi

if [ "$enable_argo" = true ]; then
    inbounds_arr+=( "{
      \"tag\": \"xhttp-argo\",
      \"listen\": \"127.0.0.1\",
      \"port\": $argo_port,
      \"protocol\": \"vless\",
      \"settings\": {
        \"clients\": [{\"id\": \"$uuid\"}],
        \"decryption\": \"none\"
      },
      \"streamSettings\": {
        \"network\": \"xhttp\",
        \"security\": \"none\",
        \"xhttpSettings\": {
          \"path\": \"/$argo_path\",
          \"mode\": \"auto\"
        }
      },
      \"sniffing\": {\"enabled\": true, \"destOverride\": [\"http\", \"tls\", \"quic\"], \"metadataOnly\": false}
    }" )
fi

inbounds_json=$(IFS=,; echo "${inbounds_arr[*]}")

cat > "${work_dir}/config.json" << EOF
{
  "log": {
    "loglevel": "warning",
    "error": "${work_dir}/xray.log"
  },
  "inbounds": [
    $inbounds_json
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
EOF

# 4. 容器后台启动 Xray-core (替代 systemd)
green "正在后台启动 Xray-core..."
"${work_dir}/xray" run -config "${work_dir}/config.json" > "${work_dir}/xray.log" 2>&1 &
XRAY_PID=$!
sleep 2

if ! kill -0 $XRAY_PID 2>/dev/null; then
    red "错误：Xray 启动失败，日志如下："
    cat "${work_dir}/xray.log"
    exit 1
fi
green "Xray 启动成功 PID=$XRAY_PID"

# 如果开启了 Argo，启动 cloudflared
argo_connections="1"
argo_proto_lower=$(echo "$argo_protocol" | tr '[:upper:]' '[:lower:]')
if [ "$argo_proto_lower" = "http2" ]; then
    argo_connections="4"
fi

if [ "$enable_argo" = true ]; then
    green "正在启动 Cloudflare Argo 固定隧道..."
    nohup "${work_dir}/cloudflared" tunnel --no-autoupdate --retries 5 --grace-period 1s --no-prechecks --protocol "${argo_protocol}" --ha-connections "${argo_connections}" run --token "${argo_token}" > "${work_dir}/cloudflared.log" 2>&1 &
fi

# 5. 获取 IP 并输出节点链接
echo "获取节点链接中..."
raw_ip=$(curl -4 -sm 2 ip.sb || curl -6 -sm 2 ip.sb || echo "IP_ERROR")
if [[ "$raw_ip" =~ : ]]; then
    server_ip="[$raw_ip]"
else
    server_ip="$raw_ip"
fi

declare -A sc=([A]=ᴀ [B]=ʙ [C]=ᴄ [D]=ᴅ [E]=ᴇ [F]=ꜰ [G]=ɢ [H]=ʜ [I]=ɪ [J]=ᴊ [K]=ᴋ [L]=ʟ [M]=ᴍ [N]=ɴ [O]=ᴏ [P]=ᴘ [Q]=ꞯ [R]=ʀ [S]=ꜱ [T]=ᴛ [U]=ᴜ [V]=ᴠ [W]=ᴡ [X]=x [Y]=ʏ [Z]=ᴢ)
uc=$(curl -sm 3 "https://ipinfo.io/country" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
[[ -z "$uc" ]] && uc="US"
isp="${sc[${uc:0:1}]}${sc[${uc:1:1}]}"
[[ -z "$isp" ]] && isp="ɴᴅ"

ESS="ᴇꜱꜱ"
cfip_h2="www.visa.com.hk"
cfip_h3="www.teamviewer.com"
cfport="443"

> "${work_dir}/url.txt"
[ -n "$reality_port" ] && echo "vless://${uuid}@${server_ip}:${reality_port}?encryption=none&security=reality&sni=${ym_vl_re}&fp=chrome&pbk=${public_key_x}&sid=${short_id_x}&type=tcp&flow=xtls-rprx-vision#${isp}%20Reality Vision%20${ESS}" >> "${work_dir}/url.txt"
[ -n "$h3_port" ] && echo "vless://${uuid}@${server_ip}:${h3_port}?encryption=none&security=tls&sni=bing.com&alpn=h3,h2&fp=chrome&type=xhttp&mode=auto&path=/${h3_path}&allowInsecure=1#${isp}%20H3-XHTTP%20${ESS}" >> "${work_dir}/url.txt"
if [ "$enable_argo" = true ]; then
    echo "vless://${uuid}@${cfip_h2}:${cfport}?encryption=none&security=tls&alpn=h2&sni=${argo_domain}&fp=chrome&type=xhttp&mode=auto&host=${argo_domain}&path=/${argo_path}#${isp}%20H2-Argo XHTTP%20${ESS}" >> "${work_dir}/url.txt"
    echo "vless://${uuid}@${cfip_h3}:${cfport}?encryption=none&security=tls&alpn=h3&sni=${argo_domain}&fp=chrome&type=xhttp&mode=auto&host=${argo_domain}&path=/${argo_path}#${isp}%20H3-Argo XHTTP%20${ESS}" >> "${work_dir}/url.txt"
fi

base64_str=$(cat "${work_dir}/url.txt" | base64 | tr -d '\n' | tr -d '\r')

green "=========================================================================================="
green " Base64 节点链接 (已完全适配 Pterodactyl 容器) "
green "=========================================================================================="
green "$base64_str"
green "=========================================================================================="
cat "${work_dir}/url.txt"

while true; do
  sleep 60
done
